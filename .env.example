# Serper API key for web searches (recommended for research quality)
# Get from: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# --- OPTIONAL INTEGRATIONS ---

# Mem0 API key for session persistence (optional)
# Enables: cross-session memory, /report regeneration from Mem0
# Without: pipeline works fully, reports saved to reports/ directory
# MEM0_API_KEY=your_mem0_api_key_here

# Slack notifications (optional)
# Enables: push notifications and full report delivery to Slack channel
# Without: reports saved to reports/ directory only
# Get Bot Token from: https://api.slack.com/apps
# SLACK_BOT_TOKEN=xoxb-your-bot-token-here
# SLACK_CHANNEL_ID=C01XXXXXXXXX

# X (Twitter) API Bearer Token (optional - falls back to web search)
# Get from: https://developer.twitter.com/en/portal/projects-and-apps
# X_BEARER_TOKEN=your_x_bearer_token_here
